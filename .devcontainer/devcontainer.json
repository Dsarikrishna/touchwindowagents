{
  "name": "Touch Window AI Agents",
  "image": "mcr.microsoft.com/devcontainers/python:3.12",
  "features": {
    "ghcr.io/devcontainers/features/node:1": {},
    "ghcr.io/devcontainers/features/azure-cli:1": {}
  },
  "postCreateCommand": "pip install -r requirements.txt && npm install -g azure-functions-core-tools@4 azurite",
  "postStartCommand": "npx azurite --silent --location .azurite &",
  "forwardPorts": [7071, 10000, 10001, 10002],
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-python.python",
        "ms-azuretools.vscode-azurefunctions"
      ]
    }
  }
}
