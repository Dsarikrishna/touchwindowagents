# Use Python 3.12 slim image
FROM python:3.12-slim

# Set working directory
WORKDIR /app

# Install streamlit and dependencies
RUN pip install streamlit requests

# Copy the user dashboard
COPY user_dashboard.py .

# Expose port
EXPOSE 8501

# Run the app
EXPOSE 8501

# Railway compatibility: Use PORT env var if available, otherwise default to 8501
CMD streamlit run user_dashboard.py --server.port=${PORT:-8501} --server.address=0.0.0.0
